# -----------------------------------------------------------------------------
# Backend environment configuration
# Copy this file to `.env` and adjust the values for your environment.
# -----------------------------------------------------------------------------

# --- Server ------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed CORS origins (the Vite dev server by default).
CORS_ORIGIN=http://localhost:5173

# --- Database (XAMPP MariaDB / MySQL) ----------------------------------------
# XAMPP default: user `root` with no password on port 3306.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root@localhost:3306/gestion_cobros"

# --- Auth --------------------------------------------------------------------
# Use long random strings in any non-local environment.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Failed-login lockout policy (section 6.1)
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Business rules ----------------------------------------------------------
# Business timezone used when formatting dates on the backend.
BUSINESS_TIMEZONE=America/Caracas
# Absolute tolerance (in bolivares) when matching reported payments to bank movements.
MATCH_AMOUNT_TOLERANCE_BS=0.01
# Matching date window (in days, +/-) around the payment date.
MATCH_DATE_WINDOW_DAYS=3
# Number of trailing reference digits used for the "partial reference" match.
MATCH_REFERENCE_SUFFIX=8
# Days since the document/payment date after which a charge is considered "old".
UMBRAL_ANTIGUEDAD_DIAS=30

# --- Uploads -----------------------------------------------------------------
UPLOAD_DIR=uploads
